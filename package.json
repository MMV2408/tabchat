{
  "name": "tabchat",
  "version": "1.20.3",
  "description": "WhatsApp, Discord, Teams, Outlook en OneDrive in één venster",
  "main": "src/main/index.js",
  "homepage": "https://github.com/MMV2408/tabchat",
  "author": {
    "name": "Mike Vijverberg",
    "email": "188231316+MMV2408@users.noreply.github.com"
  },
  "license": "MIT",
  "desktopName": "tabchat.desktop",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --linux deb AppImage",
    "dist:snap": "bash packaging/snap/build.sh"
  },
  "build": {
    "appId": "nl.mmv2408.Tabchat",
    "productName": "Tabchat",
    "linux": {
      "category": "Network",
      "icon": "assets/icon.png",
      "syncDesktopName": true,
      "synopsis": "WhatsApp, Discord, Teams, Outlook and OneDrive in one window",
      "desktop": {
        "entry": {
          "StartupNotify": "false"
        }
      }
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "publish": [
      {
        "provider": "github",
        "owner": "MMV2408",
        "repo": "tabchat"
      }
    ]
  },
  "devDependencies": {
    "electron": "^38.0.0",
    "electron-builder": "^26.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.6.2",
    "dbus-next": "^0.10.2"
  }
}
